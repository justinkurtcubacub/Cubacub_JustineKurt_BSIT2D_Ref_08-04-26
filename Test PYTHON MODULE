import functools


print(functools.partial(print,flush=True))
# helper functions

# Functions for Errors
def get_float(prompt):
    while True:
        try:
            print(prompt,end="", flush=True)
            sys.stdout.flush()
            return float(input())
        except ValueError:
            print("Invalid Input. Please type a number (e.g. 3,5).")
        except EOFError:
            print("\n No Input recieved. Exiting Program")
            raise SystemExit

def get_int(prompt):
    while True:
        try:
            print(prompt,end="", flush=True)
            sys.stdout.flush()
            return int(input())
        except ValueError:
            print("Invalid Input. Please Type a number")
        except EOFError:
            print("\n No Input recieved. Exiting Program")
            raise SystemExit

def print_header(title):
    print("\n" + "="  * 70)
    print(f"{title}")
    print("=" * 70)

def safe_input(prompt):
    try:
        print(prompt, end="", flush=True)
        sys.stdout.flush()
        return input()
    except ValueError:
        print("No Input Recieved. Exiting Program")
        raise SystemExit
    except EOFError:
        print("\n No Input Recieved. Exiting Program.")
        raise SystemExit

def pause():
    safe_input("\nPress ENTER to return to the menu...")
    mainmenu()

