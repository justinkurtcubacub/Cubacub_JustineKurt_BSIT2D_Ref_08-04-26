def General_Purpose_Functions():
    print_header("GENERAL PURPOSE FUNCTIONS")
    print("1. Compute the Ceil,Floor and trunc of a value")
    print("2. Compute a Factorial ")
    print("3. Compute the Hypotenuse of a right triangle")
    print("0. Back to Main Menu")

    choice = get_int("What is your choice: ")

    if choice == 1:
        question = safe_input("What do you want to Compute? [CEIL, FLOOR, TRUNC]: ").upper()

        if question == "CEIL":
            ceil = get_float("Give a Number you wish to Compute into CEIL: ")
            ceil1 = math.ceil(ceil)
            print(f"Your Number: {ceil} -> {ceil1}")
        elif question == "FLOOR":
            floor = get_float("Give a Number you wish to Compute into Floor: ")
            floor1 = math.floor(floor)
            print(f"Your Number: {floor} -> {floor1}")
        elif question == "TRUNC":
            trunc = get_float("Give a Number you wish to Compute into Trunc: ")
            trunc1 = math.trunc(trunc)
            print(f"Your Number: {trunc} -> {trunc1}")
        pause()

    elif choice == 2:
        question = get_int("Give a Number to compute into Factorial: ")
        try:
            print(f"Your Number: {question} -> {math.factorial(question)}")
        except ValueError:
            print("Computing into Factorial needs to be Positive Number ONLY!")
            return General_Purpose_Functions()

    elif choice == 3:
        question1 = get_float("Give the length of side A: ")
        question2 = get_float("Give the length of side A: ")
        a = question1
        b = question2

        hypotenuse = math.hypot(a,b)
        print(f"Your A is {a} and your B is {b} -> {hypotenuse}")

    elif choice == 0:
        return mainmenu()
    pause()

