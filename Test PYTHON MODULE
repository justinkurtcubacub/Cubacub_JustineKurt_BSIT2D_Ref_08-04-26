# SECTION 1
def trig_menu():
    print_header("TRIGONOMETRIC (CIRCULAR) FUNCTIONS")
    print(" 1. Show the Value of Pi\n 2. Convert Degrees -> radians \n 3. Convert Radians -> degrees \n 4. Compute Sin, Cos, Tan of an angle \n 5. Computer asin, acos, atan, of a value (-1 to 1 for asin/acos) \n 0. Back to Main menu")


    choice = get_int("Enter your Choice: ")

    if choice == 1:
        print(f"\nMath.pi = {math.pi}")
    elif choice == 2:
        deg = get_float("Enter your angle in Degrees: ")
        rad = math.radians(deg)
        print(f"\n{deg} degrees = {rad} degrees")
    elif choice == 3:
        rad = get_float("Enter an Angles in degrees: ")
        deg = math.radians(rad)
        print(f"\n{rad} radians = {deg} degrees")
    elif choice == 4:
        deg = get_float("Enter an angles in degrees: ")
        rad = math.radians(deg)
        print(f"\nAngle = {deg} degrees ({rad} radians)")
        print(f"Sin ({deg}) = {math.sin(rad)}")
        print(f"Cos ({deg}) = {math.cos(rad)}")
        print(f"Tan ({deg}) = {math.tan(rad)}")
    elif choice == 5:
        val = get_float("Enter a Value: ")
        print()
        try:
            print(f"acos({val}) = {math.asin(val)} radians"
                  f"(math.degrees{math.asin(val)} degrees ")

        except ValueError:
            print(f"asin(x) needs -1 <= x <=1. Skipped.")
        try:
            print(f"acos {val} = {math.asin(val)} radians")
            print(f"math.degrees{math.acos(val)} degrees")
        except ValueError:
            print(f"acos (x) needs -1 <= x <=1. Skipped.")
            print(f"atan {val} = {math.atan(val)} Radians")
            print(f"math.degrees(math.atan{val} degrees")
    elif choice == 0:
        return mainmenu()
    pause()

# Section 2
def Hyperbolic():
    print_header("HYPERBOLIC FUNCTIONS")
    print(
        " 1. Convert x -> Sinh,Cosh,Tanh \n 2. Convert x -> Asinh,Acosh,Atanh \n 0. Back to Main menu")

    choice = get_int(" What is your choice: ")

    if choice == 1:
        x = get_float("Type your x: ")
        print(f"{x} -> \nSinh: {math.sinh(x)} \nCosh: {math.cosh(x)} \nTanh: {math.tanh(x)}")
    elif choice == 2 :
        x = get_float("Type your x: ")
        print(f"{x} -> \nAsinh: {math.asinh(x)}")
        try:
            print(f"Acosh: {math.acosh(x)}")
        except ValueError:
            print("Value must only be below 1 to get the Acosh")
        try:
            print(f"Atanh: {math.atanh(x)}")
        except ValueError:
            print("Number must be between -1 to 1 to get Atanh")

    elif choice == 0:
        return mainmenu()
    pause()

# SECTION 3
def exponent_menu():
    print_header("EXPONENTIATION AND LOGARITHMS FUNCTIONS")

    print("1. Show the value of e")
    print("2. Compute exp(x)")
    print("3. Compute the natural log, log10, and log2 of a value")
    print("4. Compute log(x, base) with a custom base")
    print("5. Compute pow(x, y) - built-in vs math.pow")
    print("0. Back to Main Menu")

    choice = safe_input("Enter your choice: ")

    if choice == "1":
        print(f"\nmath.e = {math.e}")

    elif choice == "2":
        x = get_float("Enter x: ")
        print(f"\nexp({x}) = e^({x}) = {math.exp(x)}")

    elif choice == "3":
        x = get_float("Enter a positive number x: ")
        try:
            print(f"\nlog({x}) = {math.log(x)}")
            print(f"\nlog10({x}) = {math.log10(x)}")
            print(f"\nlog2({x}) = {math.log2(x)}")
        except ValueError:
            print("Logarithms require x > 0. Please try again.")

    elif choice == "4":
        x = get_float("Enter x (must be >0): ")
        b = get_float("Enter the base b (must be > 0 and != 1): ")
        try:
            print(f"\nlog({x}, base {b}) = {math.log(x, b)}")
        except (ValueError, ZeroDivisionError):
            print("Invalid input for a logarithm with that base.")

    elif choice == "5":
        x = get_float("Enter the base x: ")
        y = get_float("Enter the exponent y: ")

        print(f"\nBuilt-in pow({x}, {y}) = {pow(x, y)}")
        print(f"math.pow({x}, {y}) = {math.pow(x, y)}")

        print(" (Note: pow() can return an int for integer inputs; "
              "math.pow() always returns a float.)")

    elif choice == "0":
        return mainmenu()
    pause()

# Section 4
def General_Purpose_Functions():
    print_header("GENERAL PURPOSE FUNCTIONS")
    print("1. Compute the Ceil,Floor and trunc of a value")
    print("2. Compute a Factorial ")
    print("3. Compute the Hypotenuse of a right triangle")
    print("0. Back to Main Menu")

    choice = get_int("What is your choice: ")

    if choice == 1:
        question = safe_input("What do you want to Compute? [CEIL, FLOOR, TRUNC]: ").upper()

        if question == "CEIL":
            ceil = get_float("Give a Number you wish to Compute into CEIL: ")
            ceil1 = math.ceil(ceil)
            print(f"Your Number: {ceil} -> {ceil1}")
        elif question == "FLOOR":
            floor = get_float("Give a Number you wish to Compute into Floor: ")
            floor1 = math.floor(floor)
            print(f"Your Number: {floor} -> {floor1}")
        elif question == "TRUNC":
            trunc = get_float("Give a Number you wish to Compute into Trunc: ")
            trunc1 = math.trunc(trunc)
            print(f"Your Number: {trunc} -> {trunc1}")
        else:
            print("invalid input")

    elif choice == 2:
        question = get_int("Give a Number to compute into Factorial: ")
        x = math.factorial(question)
        print(f"{question} -> {x}")

    elif choice == 3:
        question1 = get_int("Give the A angle: ")
        question2 = get_int("Give the B angle: ")
        a = question1
        b = question2

        hypotenuse = math.hypot(a,b)
        print(f"Your A is {a} and your B is {b} -> {hypotenuse}")

    elif choice == 0:
        return mainmenu()
    pause()

