def Randomize():
    randomlist = ["🍅","🍇","🍈","🍉","🍊","🍌"]


    print_header("RANDOM MODULE")

    print("1. Set a Seed")
    print("2. Generate a Number with randrange")
    print("3. Generate a number with Randint")
    print("4. Pick a Random item from a list with choice")
    print("5. Draw Several Unique Items from a list ")
    print("0. Exit Program")

    choice = get_int("Your Choices: ")

    if choice == 1:
        ran = random.randint(1, 100)
        print(f"You generated: {ran}")
    elif choice == 2:
        ran = random.randrange(1,1000)
        print(f"You Generated: {ran}")
    elif choice == 3:
        ran = random.randint(1, 1000)
        print(f"You Generated: {ran}")
    elif choice == 4:
        spin = random.choice(randomlist)
        print(f"You Spinned: {spin}")
    elif choice == 5:
        print("PLACEHOLDER")
    pause()
