def exponent_menu():
    print_header("EXPONENTIATION AND LOGARITHMS FUNCTIONS")

    print("1. Show the value of e")
    print("2. Compute exp(x)")
    print("3. Compute the natural log, log10, and log2 of a value")
    print("4. Compute log(x, base) with a custom base")
    print("5. Compute pow(x, y) - built-in vs math.pow")
    print("0. Back to Main Menu")

    choice = safe_input("Enter your choice: ")

    if choice == "1":
        print(f"\nmath.e = {math.e}")

    elif choice == "2":
        x = get_float("Enter x: ")
        print(f"\nexp({x}) = e^({x}) = {math.exp(x)}")

    elif choice == "3":
        x = get_float("Enter a positive number x: ")
        try:
            print(f"\nlog({x}) = {math.log(x)}")
            print(f"\nlog10({x}) = {math.log10(x)}")
            print(f"\nlog2({x}) = {math.log2(x)}")
        except ValueError:
            print("Logarithms require x > 0. Please try again.")

    elif choice == "4":
        x = get_float("Enter x (must be >0): ")
        b = get_float("Enter the base b (must be > 0 and != 1): ")
        try:
            print(f"\nlog({x}, base {b}) = {math.log(x, b)}")
        except (ValueError, ZeroDivisionError):
            print("Invalid input for a logarithm with that base.")

    elif choice == "5":
        x = get_float("Enter the base x: ")
        y = get_float("Enter the exponent y: ")

        print(f"\nBuilt-in pow({x}, {y}) = {pow(x, y)}")
        print(f"math.pow({x}, {y}) = {math.pow(x, y)}")
        print(" (Note: pow() can return an int for integer inputs; "
              "math.pow() always returns a float.)")

    elif choice == "0":
        return mainmenu()
    pause()

